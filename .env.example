# MongoDB (local mongod by default)
MONGODB_URI=mongodb://127.0.0.1:27017/event_pass

# Auth.js - generate with `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated accounts that get the admin role
ADMIN_EMAILS=

# Shared password for the admin email/password sign-in (leave empty to disable)
ADMIN_PASSWORD=

# Vercel Blob (file uploads) - provided automatically on Vercel
BLOB_READ_WRITE_TOKEN=

# Optional Redis. Used for rate limiting and the public event-list cache.
# Leave unset to disable both; the app behaves exactly as before. Accepts:
#   UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN
#   KV_REST_API_URL / KV_REST_API_TOKEN   (Vercel Upstash integration)
#   REDIS_URL=redis://...                 (Vercel Redis Cloud integration)
# REST is preferred on serverless; TCP works too and fails open the same way.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_URL=

# Public app URL, used for links inside emails (defaults to NEXTAUTH_URL,
# then http://localhost:3000)
APP_URL=

# Outgoing mail (ticket delivery) - provider-agnostic SMTP. Everything is
# optional: when SMTP_HOST is unset, no mail is sent and the app behaves
# exactly as without it. Examples:
#   Gmail:  host=smtp.gmail.com port=587 secure=false user=you@gmail.com
#           pass=<16-char App Password> from="EventPass <you@gmail.com>"
#   Resend: host=smtp.resend.com port=587 user=resend pass=<api key>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Dynamic mail accounts (Phase 1 config; account management UI comes later)
# Generate a key with:
#   node --input-type=module -e "import {randomBytes} from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# Required only when per-admin Gmail accounts are stored in the database.
MAIL_CREDENTIALS_KEY=

# Secret used to sign short ticket links in emails (/t/<code>). Falls back to
# NEXTAUTH_SECRET or MAIL_CREDENTIALS_KEY, but a dedicated value is recommended.
SHORT_LINK_SECRET=

# Main provider and bulk-send behavior. All have safe defaults and are optional.
MAIL_DEFAULT_PROVIDER=gmail
MAIL_SEND_INTERVAL_MS=400
MAIL_BATCH_POLL_MS=2000
MAIL_BATCH_CHUNK_SIZE=20
